# LeaveTrack environment variables. Copy to .env.local. Never commit real secrets.
# Day 0 runs with none of these set; defaults apply.

# --- App ---
NODE_ENV=development
# dev | staging | prod
APP_ENV=dev
# debug | info | warn | error
LOG_LEVEL=info

# --- Mock session (Day 0 only, see ADR-LeaveTrack-E001) ---
SESSION_COOKIE_NAME=mock-role
# 8 hours
SESSION_MAX_AGE_SECONDS=28800

# --- Day 1: database (Supabase Postgres). Use the POOLER url, not the direct connection. ---
# DATABASE_URL=postgresql://<user>:<password>@<project>.pooler.supabase.com:6543/postgres
# NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# Safe for the browser ONLY because Row Level Security is enabled on every table.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only secret key (replaces the legacy service_role key). Bypasses RLS.
# Never prefix with NEXT_PUBLIC_, never commit.
# SUPABASE_SECRET_KEY=sb_secret_...
# Public JWKS endpoint used to verify session JWTs (Day 1 real auth).
# SUPABASE_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json

# --- Day 1: scheduled accrual job (Vercel Cron sends this as a Bearer token) ---
# Required for /api/jobs/accrual (Vercel Cron sends it as a Bearer token). Without it the route refuses (503).
# Generate: openssl rand -hex 32
# CRON_SECRET=
